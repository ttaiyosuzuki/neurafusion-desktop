<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows 固有の部品。Windows.Media.Ocr（WinRT）を使うため Windows 10 2004（19041）以上の TFM にする。
    Mac の上では -p:EnableWindowsTargeting=true でビルドだけできる（実行は Windows のみ）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- System.Windows.Automation（UIAutomationClient / UIAutomationTypes）は WPF の参照に入っている -->
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>nf-overlay</AssemblyName>
    <RootNamespace>NfOverlay.Win</RootNamespace>
    <Version>0.1.0</Version>
    <Product>NeuraFusion Overlay</Product>
    <Company>NeuraFusion</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NfOverlay.Core/NfOverlay.Core.csproj" />
  </ItemGroup>

</Project>
