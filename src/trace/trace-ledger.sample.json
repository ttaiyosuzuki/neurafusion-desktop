 "prereq_topics": [
  {
   "id": "p01",
   "target_action": "AIで動く小さなサービスの一部を、AIに見張らせる",
   "domain": "ソフトウェア・AIサービス",
   "lens_ids": [
    "V07-1_software_development",
    "V11-1_server_monitoring"
   ],
   "must_include_actions": [
    "コードのこの行を直す",
    "別のソフトを3つ挟む",
    "ここだけAIに見張らせる",
    "トークンを入れる"
   ],
   "must_include_paths": [
    "GitHubの画面で直接直す",
    "GitHub Desktop",
    "Cursor",
    "ターミナル"
   ]
  },
  {
   "id": "p02",
   "target_action": "自社の決算書（損益計算書・貸借対照表）を自分で読んで、おかしい所に気づく",
   "domain": "税務・会計",
   "lens_ids": [
    "V10-2_accounting_closing",
    "V10-1_tax_filing"
   ],
   "must_include_actions": [
    "損益計算書を読む",
    "貸借対照表を読む",
    "減価償却の行を確かめる"
   ],
   "must_include_paths": []
  },
  {
   "id": "p03",
   "target_action": "タームシートを読んで、自分の持ち株比率と権利に何が起きるかを理解する",
   "domain": "投資・資金調達",
   "lens_ids": [
    "V04-3_fundraising",
    "V03-1_investment_decision"
   ],
   "must_include_actions": [
    "バリュエーションの欄を読む",
    "優先株の条項を読む",
    "希薄化を計算する"
   ],
   "must_include_paths": []
  },
  {
   "id": "p04",
   "target_action": "創業融資を申し込んで、面談を受ける",
   "domain": "銀行・公庫の融資",
   "lens_ids": [
    "V03-2_bank_loan_review"
   ],
   "must_include_actions": [
    "創業計画書を書く",
    "自己資金を示す",
    "資金使途を分ける（運転資金と設備資金）"
   ],
   "must_include_paths": []
  },
  {
   "id": "p05",
   "target_action": "広告の成果を CPA・CVR で読み、続けるか止めるかを決める",
   "domain": "マーケティングの数字",
   "lens_ids": [
    "V06-1_marketing"
   ],
   "must_include_actions": [
    "CPAを計算する",
    "CVRを読む",
    "LTVと比べる"
   ],
   "must_include_paths": []
  },
  {
   "id": "p06",
   "target_action": "店舗の内装工事を発注して、必要な届け出と検査を通す",
   "domain": "建築の手続き",
   "lens_ids": [
    "V07-4_architecture",
    "V01-3_construction_schedule"
   ],
   "must_include_actions": [
    "建築確認が要るか確かめる",
    "消防への届け出",
    "工程表を読む"
   ],
   "must_include_paths": []
  },
  {
   "id": "p07",
   "target_action": "注文が入ったら、壊さず・遅れず・損せず全国に送る",
   "domain": "物流の言葉",
   "lens_ids": [
    "V14-1_logistics"
   ],
   "must_include_actions": [
    "サイズと重さで送料を決める",
    "運送約款を読む（壊れた時の補償）",
    "送り状を作る"
   ],
   "must_include_paths": []
  },
  {
   "id": "p08",
   "target_action": "親の要介護認定を申請して、ケアプランができるまで進める",
   "domain": "介護",
   "lens_ids": [
    "V13-2_elder_care"
   ],
   "must_include_actions": [
    "地域包括支援センターに相談する",
    "認定調査を受ける",
    "ケアマネジャーを決める"
   ],
   "must_include_paths": []
  },
  {
   "id": "p09",
   "target_action": "契約書に印紙が要るか判断し、要るなら正しく貼る（電子契約の道も含む）",
   "domain": "契約・法務",
   "lens_ids": [
    "V05-3_contract_review"
   ],
   "must_include_actions": [
    "契約書の種類（号）を見分ける",
    "印紙税額を確かめる",
    "電子契約にする"
   ],
   "must_include_paths": [
    "紙で結んで印紙を貼る",
    "電子契約で結ぶ"
   ]
  },
  {
   "id": "p10",
   "target_action": "ドローンを飛ばして自分の畑を撮影し、生育の違いを見る",
   "domain": "ドローンの運用",
   "lens_ids": [
    "V14-4_drone_operation"
   ],
   "must_include_actions": [
    "機体を登録する",
    "飛行の許可・承認が要るか確かめる",
    "撮影した画像で生育を比べる"
   ],
   "must_include_paths": [
    "自分で飛ばす",
    "業者に頼む",
    "衛星画像で代える"
   ]
  }
